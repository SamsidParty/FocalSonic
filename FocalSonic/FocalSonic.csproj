<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
	 <IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</IsWindows>
	 <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
	 <IsMac Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsMac>
	 <Configurations>Debug;Release</Configurations>
  </PropertyGroup>



	<PropertyGroup Condition="'$(IsWindows)'=='true'">
		<DefineConstants>WINDOWS</DefineConstants>
		<TargetFramework>net9.0-windows10.0.19041</TargetFramework>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup Condition="'$(IsWindows)'=='true'">
		<Reference Include="PresentationFramework.Fluent" />
	</ItemGroup>
	
	<PropertyGroup Condition="'$(IsLinux)'=='true'">
		<DefineConstants>LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsMac)'=='true'">
		<DefineConstants>MACOS</DefineConstants>
	</PropertyGroup>

	<!-- IgniteView -->
	<ItemGroup Condition="'$(Configuration)'=='Local Debug'">
		<ProjectReference Include="..\..\WebFramework\IgniteView.Core\IgniteView.Core.csproj" />
		<ProjectReference Include="..\..\WebFramework\IgniteView.Desktop\IgniteView.Desktop.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'!='Local Debug'">
		<PackageReference Include="IgniteView.Desktop" Version="2.2.7" />
		<PackageReference Include="IgniteView.Core" Version="*" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="GoogleCast" Version="1.7.0" />
		<PackageReference Include="SoundFlow" Version="1.2.0" />
		<PackageReference Include="System.Drawing.Common" Version="9.0.8" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
		<PackageReference Include="System.Security.Permissions" Version="8.0.0" />
	</ItemGroup>
	<PropertyGroup>
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
		<JSFramework>react</JSFramework>
		<!-- This is required for IgniteView to know what js framework you are using -->
		<ScriptsURL>https://raw.githubusercontent.com/SamsidParty/IgniteView/refs/heads/main/IgniteView.Scripts</ScriptsURL>
		<PreBuildCommand>node -e "fetch('$(ScriptsURL)/Prebuild.js').then((c) =&gt; c.text().then(eval))" "$(ScriptsURL)" "$(MSBuildProjectDirectory.Replace('\', '\\'))" "$(Configuration)" "$(JSFramework)"</PreBuildCommand>
		<PostBuildCommand>node -e "fetch('$(ScriptsURL)/Postbuild.js').then((c) =&gt; c.text().then(eval))" "$(ScriptsURL)" "$(MSBuildProjectDirectory.Replace('\', '\\'))" "$(Configuration)" "$(JSFramework)"</PostBuildCommand>
	</PropertyGroup>
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="$(PreBuildCommand) &quot;$(OutputPath.Replace('\', '\\'))&quot;" />
	</Target>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="$(PostBuildCommand) &quot;$(OutputPath.Replace('\', '\\'))&quot;" />
	</Target>
	<ItemGroup>
		<Content Include="iv2runtime\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="'$(IsLinux)'=='true'">
		<Content Include="src-vite\public\favicons\favicon-32x32.png" Link="iv2runtime\focalsonic-tray.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <Content Remove="C:\Users\Samarth\.nuget\packages\igniteview.desktop\2.2.5\contentFiles\any\net9.0\iv2runtime\linux-arm64\native\libIgniteView.Desktop.Native.so" />
	  <Content Remove="C:\Users\Samarth\.nuget\packages\igniteview.desktop\2.2.5\contentFiles\any\net9.0\iv2runtime\linux-x64\native\libIgniteView.Desktop.Native.so" />
	  <Content Remove="C:\Users\Samarth\.nuget\packages\igniteview.desktop\2.2.5\contentFiles\any\net9.0\iv2runtime\osx-universal\native\libIgniteView.Desktop.Native.dylib" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\SamsidParty.Subsonic.Common\SamsidParty.Subsonic.Common.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="Sharpcaster">
	    <HintPath>Sharpcaster.dll</HintPath>
	  </Reference>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="ExtraFeatures\" />
	</ItemGroup>
	

</Project>
