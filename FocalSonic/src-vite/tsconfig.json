{
  "compilerOptions": {
    "jsx": "react",
    "composite": true,
    "skipLibCheck": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
    }
  },
  "include": [
    "vite.config.ts",
    "src"
  ]
}