{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./*"],
      "src/*": ["./src/*"],
    }
  },
  "include": [
    "src/manual-chunks.ts",
    "vite.config.ts"
  ]
}