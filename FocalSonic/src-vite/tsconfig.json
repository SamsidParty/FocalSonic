{
  "compilerOptions": {
    "jsx": "react-jsx",
    "composite": true,
    "skipLibCheck": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
    }
  },
  "include": [
    "vite.config.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/api/podcastClient.ts",
    "src/app/components/player/podcast-info.tsx",
    "src/app/components/player/podcast-playback-rate.tsx",
    "src/queries/podcasts.ts",
    "src/service/subsonic/podcasts.ts",
    "src/types/responses/podcasts.ts"
  ]
}