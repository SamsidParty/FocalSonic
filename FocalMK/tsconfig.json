{
    "compilerOptions": {
        "target": "es2024",
        "module": "esnext",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "declaration": true 
    },
    "include": ["src/**/*.ts"]
}